# ---- Bakrey CRM environment — copy to ".env" and fill in REAL values ----
# NEVER commit .env. NEVER reuse the values that were in the old repo's .env:
# those credentials were shared in a ZIP and must be treated as compromised.
# Rotate: (1) Atlas database user password, (2) JWT_SECRET, (3) BACKUP_ENCRYPTION_KEY.

# Backend (Express)
MONGODB_URI=mongodb+srv://admin:hadiya1009@cluster0.nyhsnmf.mongodb.net/bakrey-crm?retryWrites=true&w=majority&connectTimeoutMS=10000&serverSelectionTimeoutMS=5000
JWT_SECRET="42a999562f80c2d2113fea1a49e60afaafb9a94a3e160c159e815dbb6e78b381"
JWT_EXPIRES_IN="8h"

# Session cookie (the JWT is sent as an HttpOnly cookie — never to JS/localStorage)
# Frontend and API on DIFFERENT sites (e.g. Vercel + Railway) and HTTPS in production:
#   defaults are already correct (Secure + SameSite=None).
# Frontend and API on the SAME site? Set COOKIE_SAMESITE="lax" for stricter CSRF protection.
# COOKIE_SAMESITE="none"
# COOKIE_SECURE="true"
# AUTH_COOKIE_NAME="akb_session"
# ALLOW_BEARER_AUTH="false"   # dev-only escape hatch for Postman-style clients; keep false in production
CLIENT_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"
UPLOAD_DIR="uploads"
BACKUP_ENCRYPTION_KEY="42a999562f80c2d2113fea1a49e60afaafb9a94a3e160c159e815dbb6e78b381"

# Optional policy knobs (defaults shown)
# EXPIRY_WARNING_DAYS=30
# LATE_TO_ABSENT_RATIO=3
# OVERTIME_MULTIPLIER=1
# TRUST_PROXY=false

# Frontend (Vite — build-time, must be set where the frontend is built/deployed)
VITE_API_URL="http://localhost:4000/api"

# Seed script only (server/scripts/seedUsers.js) — required, no defaults in code
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=AdminPass1009!
SEED_MANAGER_USERNAME="manager"
SEED_MANAGER_PASSWORD=ManagerPass1009!
SEED_CASHIER_PIN=100913
# ---------- v3: Loyalty ----------
# Earn 1 point per Rs 100 paid; 1 point = Rs 1 off at redemption.
LOYALTY_STEP_PKR=100
LOYALTY_POINTS_PER_STEP=1
LOYALTY_POINT_VALUE_PKR=1

# ---------- v3: Notifications (WhatsApp / SMS / Email) ----------
# Public URL of the frontend, used in invoice links sent to customers.
APP_PUBLIC_URL=http://localhost:5173
# none | twilio | meta  (none = messages are logged, not sent — safe default)
NOTIFY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Daily low-stock / expiry digest recipients + schedule
ADMIN_ALERT_PHONE=
ADMIN_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_DIGEST_ENABLED=false
ALERT_DIGEST_TIME=09:00

# ---------- v3: Encrypted file backups ----------
BACKUP_DIR=backups
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_TIME=02:00
# Optional S3 upload (leave bucket empty for local-only backups)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
